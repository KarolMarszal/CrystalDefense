[gd_resource type="Resource" script_class="MapData" load_steps=13 format=3]

[ext_resource type="Script" path="res://maps/MapData.gd" id="1_map_data"]
[ext_resource type="Script" path="res://maps/MapEnemyEntry.gd" id="2_map_enemy_entry"]
[ext_resource type="Resource" path="res://enemies/Goblin.tres" id="3_goblin"]
[ext_resource type="Resource" path="res://enemies/Kobold.tres" id="4_kobold"]
[ext_resource type="Resource" path="res://enemies/Skeleton.tres" id="5_skeleton"]
[ext_resource type="Resource" path="res://enemies/Orc.tres" id="6_orc"]
[ext_resource type="Resource" path="res://enemies/Troll.tres" id="7_troll"]

[sub_resource type="Resource" id="GoblinEntry"]
script = ExtResource("2_map_enemy_entry")
enemy_data = ExtResource("3_goblin")
weight_multiplier = 1.2

[sub_resource type="Resource" id="KoboldEntry"]
script = ExtResource("2_map_enemy_entry")
enemy_data = ExtResource("4_kobold")
weight_multiplier = 1.4

[sub_resource type="Resource" id="SkeletonEntry"]
script = ExtResource("2_map_enemy_entry")
enemy_data = ExtResource("5_skeleton")
weight_multiplier = 0.8

[sub_resource type="Resource" id="OrcEntry"]
script = ExtResource("2_map_enemy_entry")
enemy_data = ExtResource("6_orc")
weight_multiplier = 1.0

[sub_resource type="Resource" id="TrollEntry"]
script = ExtResource("2_map_enemy_entry")
enemy_data = ExtResource("7_troll")
weight_multiplier = 0.6

[resource]
script = ExtResource("1_map_data")
map_id = &"forest"
display_name = "Forest"
enemy_entries = Array[ExtResource("2_map_enemy_entry")]([SubResource("GoblinEntry"), SubResource("KoboldEntry"), SubResource("SkeletonEntry"), SubResource("OrcEntry"), SubResource("TrollEntry")])
